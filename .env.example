# Copy to .env.local to point the app at a different Supabase project.
# Without it, the app uses the team project set in src/services/supabaseClient.js.
# Both values are on the Supabase dashboard under Project Settings → API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
